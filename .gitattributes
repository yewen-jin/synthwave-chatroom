# Auto detect text files and perform LF normalization
* text=auto

# Configuration files
vite.config.js merge=ours
server.js merge=ours
render.yaml merge=ours

# Environment files (if you have them)
.env.production merge=ours
.env merge=ours

# Append-only decision log: built-in union merge so parallel branch/worktree
# appends merge cleanly. Do NOT change to merge=ours or configure a driver —
# see CLAUDE.md worktree trap 3.
WORKLOG.md merge=union
