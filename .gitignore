# Claude Code — selective on purpose: .claude/settings.json IS tracked
# (it carries the shared worktree config), so do not ignore .claude/ wholesale.
.claude/settings.local.json
.claude/worktrees/

# Card-game audio — served from audio-assets/, kept out of git so Symone
# re-exports never enter history. Dev placeholders are regenerated via
# `npm run make:audio` (see scripts/make-placeholder-audio.js).
/audio-assets/

# Live room sessions (server.js -> data/room-sessions.json). Runtime state
# that lets a pair reopen their #hash and find their game after a drop or a
# restart. It belongs to whichever server wrote it and must never travel
# through git: committing it would push one machine's live rooms onto another,
# and it records what players were doing. The server recreates it as needed.
/data/
